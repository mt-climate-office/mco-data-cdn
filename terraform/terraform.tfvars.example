aws_region  = "us-west-2"
aws_profile = "mco"

# `description` is optional; the data browser shows it on the landing page.
# `private = true` serves a bucket over OAC (required when the bucket has a
# public-access block) and makes the browser list it through the CDN.
origin_buckets = {
  gridmet = {
    bucket_name            = "mco-gridmet"
    bucket_regional_domain = "mco-gridmet.s3.us-west-2.amazonaws.com"
    description            = "GridMET climate and drought grids as COGs"
  }
  snodas = {
    bucket_name            = "mco-snodas"
    bucket_regional_domain = "mco-snodas.s3.us-west-2.amazonaws.com"
    description            = "SNODAS snow water equivalent COGs and summaries"
  }
}

# Volatile paths get short TTLs (default: 1h default, 6h max)
# volatile_default_ttl    = 3600
# volatile_max_ttl        = 21600
# volatile_path_patterns  = ["latest"]

# Archival data gets long TTLs (default: 1d default, 7d max)
# default_ttl = 86400
# max_ttl     = 604800

# Custom domain — all three are required together.
# See README.md for certificate import instructions.
# custom_domain        = "data2.climate.umt.edu"
# enable_custom_domain = true
# acm_certificate_arn  = "arn:aws:acm:us-east-1:ACCOUNT:certificate/CERT-ID"
